// PRINT
label print
createframe
pushframe

defvar LF@value
defvar LF@type
defvar LF@isnil
pops LF@value
type LF@type LF@value
eq LF@isnil LF@type string@nil
jumpifeq print$unit LF@isnil bool@true
write LF@value
jump print$end

label print$unit
write string@()

label print$end
popframe
return


// READLINE
label readline
createframe
pushframe

defvar LF@value
defvar LF@type
defvar LF@isnil
read LF@value string
type LF@type LF@value
eq LF@isnil LF@type string@nil
jumpifeq readline$eof LF@isnil bool@true
pushs LF@value
jump readline$end

label readline$eof
pushs string@

label readline$end
popframe
return


// READINT
label readint
createframe
pushframe

defvar LF@value
defvar LF@type
defvar LF@isnil
read LF@value int
type LF@type LF@value
eq LF@isnil LF@type string@nil
jumpifeq readint$bad LF@isnil bool@true
pushs LF@value
jump readint$end

label readint$bad
pushs int@0

label readint$end
popframe
return


